# Cloudflare Web Search Plugin Configuration
# Required:
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Optional dedicated overrides (isolate web search from other Hermes plugins/providers):
# (CLOUDFLARE_WEB_SEARCH_* and CLOUDFLARE_SEARCH_* aliases are both supported)
# CLOUDFLARE_WEB_SEARCH_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_WEB_SEARCH_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_WEB_SEARCH_PROVIDER=ceramic # ceramic (default) | exa | linkup
# CLOUDFLARE_WEB_SEARCH_GATEWAY_ID=default
# CLOUDFLARE_WEB_SEARCH_BYOK_ALIAS=your-stored-key-alias  # only set if stored on the gateway; unset uses stored 'default' key if present, otherwise credits
# CLOUDFLARE_WEB_SEARCH_MAX_DESCRIPTION_CHARS=2000
# CLOUDFLARE_WEB_SEARCH_TIMEOUT=20

